{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (-O0 -g)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (-O2, hardened)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "FRAMEFLOW_HARDENING": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "FRAMEFLOW_SANITIZER": "asan"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "TSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "FRAMEFLOW_SANITIZER": "tsan",
        "CMAKE_CROSSCOMPILING_EMULATOR": "setarch;-R"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage (gcov, -O0)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g",
        "FRAMEFLOW_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "filter": { "exclude": { "label": "timing|long|stress" } }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "exclude": { "label": "long|stress" } }
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": { "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1" },
      "filter": { "exclude": { "label": "timing|long|stress" } }
    },
    {
      "name": "tsan-env",
      "hidden": true,
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:suppressions=${sourceDir}/tsan.supp" }
    },
    {
      "name": "tsan",
      "inherits": "tsan-env",
      "filter": { "exclude": { "label": "timing|long|stress" } }
    },
    {
      "name": "debug-long",
      "inherits": "base",
      "configurePreset": "debug",
      "filter": { "include": { "label": "long|stress" } }
    },
    {
      "name": "tsan-long",
      "inherits": "tsan-env",
      "filter": { "include": { "label": "long|stress" } }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "filter": { "exclude": { "label": "timing|long|stress" } }
    }
  ]
}
